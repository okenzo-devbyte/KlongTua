            android:paddingEnd="6dp"
            android:text="○"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_task_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ชื่อรายการ"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_task_subtitle_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="รายละเอียด"
                android:textColor="#64748B"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_task_amount_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="฿0"
            android:textColor="#0F172A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="ไม่มีรายการค้างชำระในเดือนนี้ 🎉"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
