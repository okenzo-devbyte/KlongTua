<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_clean"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: App Brand + Sufficiency Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="คล่องตัว"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ เงินต้นพอจ่าย"
            android:textColor="#059669"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Monthly Remaining Amount (Big Number) -->
    <TextView
        android:id="@+id/tv_widget_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="฿0"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle: Month + Available Cash / Total Remaining Debt -->
    <TextView
        android:id="@+id/tv_widget_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="คล่องตัว • ซิงก์ข้อมูลอัตโนมัติ"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#E2E8F0"
        android:contentDescription="@null" />

    <!-- Tasks Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task Row 1 -->
        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_task_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_widget_task_check_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_task_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ชื่อรายการ"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_task_subtitle_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="รายละเอียด"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_task_amount_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="฿0"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Row 2 -->
        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_task_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_widget_task_check_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_task_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ชื่อรายการ"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_task_subtitle_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="รายละเอียด"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_task_amount_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="฿0"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Row 3 -->
        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/widget_task_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_widget_task_check_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_task_title_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ชื่อรายการ"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_task_subtitle_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="รายละเอียด"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_task_amount_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="฿0"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Row 4 -->
        <LinearLayout
            android:id="@+id/widget_task_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:background="@drawable/widget_task_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_widget_task_check_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="○"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_widget_task_title_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ชื่อรายการ"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_task_subtitle_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="รายละเอียด"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_task_amount_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="฿0"
                android:textColor="#0F172A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State Label -->
        <TextView
            android:id="@+id/tv_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="ไม่มีรายการค้างชำระในเดือนนี้ 🎉"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>